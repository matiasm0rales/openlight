{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "calibration",
  "description": "Ventana de calibración a pantalla completa: escuchar eventos, los comandos de esa pantalla (y de las acciones de sus errores) y abrir la ayuda de Tuya. La ventana la abre y la cierra el backend.",
  "windows": ["calibration"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://iot.tuya.com" },
        { "url": "https://iot.tuya.com/*" }
      ]
    },
    "allow-onboarding-state",
    "allow-devices-list",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-reset",
    "allow-profiles-list",
    "allow-session-state",
    "allow-session-start",
    "allow-session-stop",
    "allow-displays-list",
    "allow-calibration-start",
    "allow-calibration-set",
    "allow-calibration-save",
    "allow-calibration-cancel",
    "allow-renew-key",
    "allow-device-set-in-effect",
    "allow-open-system-settings",
    "allow-repair-screen-permission"
  ]
}
