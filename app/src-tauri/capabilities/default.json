{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ventana principal: solo lo que usa la UI. tests/permisos.rs comprueba la lista completa.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:resources:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://iot.tuya.com" },
        { "url": "https://iot.tuya.com/*" },
        { "url": "https://github.com/matiasm0rales/openlight/releases/*" }
      ]
    },
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart",
    "allow-onboarding-state",
    "allow-onboarding-save",
    "allow-check-permissions",
    "allow-open-system-settings",
    "allow-cloud-validate",
    "allow-cloud-list-devices",
    "allow-discover-lan",
    "allow-devices-list",
    "allow-device-add",
    "allow-device-update",
    "allow-device-remove",
    "allow-device-test",
    "allow-device-manual",
    "allow-device-set-in-effect",
    "allow-renew-key",
    "allow-displays-list",
    "allow-display-preview",
    "allow-zones-set",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-reset",
    "allow-profiles-list",
    "allow-profiles-create",
    "allow-profiles-update",
    "allow-profiles-delete",
    "allow-profiles-activate",
    "allow-session-state",
    "allow-session-start",
    "allow-session-stop",
    "allow-calibration-start",
    "allow-calibration-set",
    "allow-calibration-save",
    "allow-calibration-cancel",
    "allow-update-prepare",
    "allow-update-abort",
    "allow-ui-ready",
    "allow-ui-hold",
    "allow-import-legacy",
    "allow-diagnostics-log",
    "allow-diagnostics-export"
  ]
}
