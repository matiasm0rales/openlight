{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLight",
  "version": "0.1.0",
  "identifier": "io.github.matiasm0rales.openlight",
  "build": {
    "beforeDevCommand": "pnpm --filter openlight-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter openlight-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenLight",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "OpenLight contributors",
    "copyright": "Copyright © OpenLight contributors",
    "category": "Utility",
    "shortDescription": "Ambilight para focos Tuya / Smart Life",
    "longDescription": "OpenLight sincroniza focos Tuya / Smart Life con los colores de tu pantalla (ambilight) usando el protocolo local, sin pasar por la nube en cada cuadro.",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0"
        ]
      },
      "rpm": {
        "depends": [
          "pipewire-libs"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REEMPLAZAR_POR_LA_CLAVE_PUBLICA_DEL_UPDATER (ver docs/release.md)",
      "endpoints": [
        "https://github.com/matiasm0rales/openlight/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
